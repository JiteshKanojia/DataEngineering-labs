# ============================================================
# de-labs stack configuration  (copy to .env and edit as needed)
# Every value below is also a compose default - the stack runs
# fine with no .env file at all.
# ============================================================

# --- Spark cluster sizing (lower these if you have < 8GB RAM) ---
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=4
JUPYTER_DRIVER_MEMORY=1536M
CONNECT_DRIVER_MEMORY=1G

# --- Jupyter ---
JUPYTER_TOKEN=study

# --- Fake event stream generator ---
GEN_INTERVAL_SECONDS=3
GEN_EVENTS_PER_FILE=200
GEN_LATE_PCT=3
GEN_DUP_PCT=2
